# Copy to .env (never commit .env).

# Enables the cloudflared service. Leave empty to run Home Assistant only.
COMPOSE_PROFILES=tunnel

# Token from Cloudflare dashboard > Networking > Tunnels > (tunnel) > Docker.
TUNNEL_TOKEN=

# Home Assistant long-lived access token (profile > security), used for API calls.
HA_TOKEN=

# Tapo C320WS continuous recording (camera-recorder). "Camera account" created in
# the Tapo app; stream1 = full resolution. Never commit the real value.
CAMERA_RTSP_URL=rtsp://USER:PASSWORD@CAMERA_IP:554/stream1

# Live WebRTC stream to external VPS (camera-vps-stream).
# Pushes the stream to the VPS via TCP; survives home dynamic IP changes.
VPS_RTSP_PUSH_URL=rtsp://corredor:PASSWORD@camera.SEUDOMINIO.com.br:8554/corredor
